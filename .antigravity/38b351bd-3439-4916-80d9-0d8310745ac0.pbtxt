  view_file {
    absolute_path_uri: "file:///src/index.css"
    end_line: 75
    content: "@import \"tailwindcss\";\n\n@layer base {\n  :root {\n    --font-sans: \'Plus Jakarta Sans\', -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif;\n    --font-display: \'Syne\', \'Plus Jakarta Sans\', sans-serif;\n    --font-mono: \'JetBrains Mono\', monospace;\n  }\n\n  body {\n    font-family: var(--font-sans);\n    background-color: #0A0A0B;\n    color: #F4F4F6;\n    overflow-x: hidden;\n  }\n\n  h1, h2, h3, .font-display {\n    font-family: var(--font-display);\n  }\n\n  .font-mono {\n    font-family: var(--font-mono);\n  }\n}\n\n/* Custom broadcast UI utilities */\n.bg-grid-pattern {\n  background-size: 40px 40px;\n  background-image: \n    linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),\n    linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);\n}\n\n.bg-dot-pattern {\n  background-size: 24px 24px;\n  background-image: radial-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px);\n}\n\n.broadcast-glow {\n  box-shadow: 0 0 35px -5px rgba(0, 102, 255, 0.35);\n}\n\n.tally-live-pulse {\n  animation: pulse-live 1.8s cubic-bezier(0.4, 0, 0.6, 1) infinite;\n}\n\n@keyframes pulse-live {\n  0%, 100% {\n    opacity: 1;\n    box-shadow: 0 0 14px rgba(0, 102, 255, 0.9), 0 0 24px rgba(0, 229, 255, 0.5);\n  }\n  50% {\n    opacity: 0.4;\n    box-shadow: 0 0 4px rgba(0, 102, 255, 0.3);\n  }\n}\n\n/* Custom subtle scrollbar */\n::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n\n::-webkit-scrollbar-track {\n  background: #0A0A0B;\n}\n\n::-webkit-scrollbar-thumb {\n  background: #26262C;\n  border-radius: 3px;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: #0066FF;\n}\n"
    raw_content: "@import \"tailwindcss\";\n\n@layer base {\n  :root {\n    --font-sans: \'Plus Jakarta Sans\', -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif;\n    --font-display: \'Syne\', \'Plus Jakarta Sans\', sans-serif;\n    --font-mono: \'JetBrains Mono\', monospace;\n  }\n\n  body {\n    font-family: var(--font-sans);\n    background-color: #0A0A0B;\n    color: #F4F4F6;\n    overflow-x: hidden;\n  }\n\n  h1, h2, h3, .font-display {\n    font-family: var(--font-display);\n  }\n\n  .font-mono {\n    font-family: var(--font-mono);\n  }\n}\n\n/* Custom broadcast UI utilities */\n.bg-grid-pattern {\n  background-size: 40px 40px;\n  background-image: \n    linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),\n    linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);\n}\n\n.bg-dot-pattern {\n  background-size: 24px 24px;\n  background-image: radial-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px);\n}\n\n.broadcast-glow {\n  box-shadow: 0 0 35px -5px rgba(0, 102, 255, 0.35);\n}\n\n.tally-live-pulse {\n  animation: pulse-live 1.8s cubic-bezier(0.4, 0, 0.6, 1) infinite;\n}\n\n@keyframes pulse-live {\n  0%, 100% {\n    opacity: 1;\n    box-shadow: 0 0 14px rgba(0, 102, 255, 0.9), 0 0 24px rgba(0, 229, 255, 0.5);\n  }\n  50% {\n    opacity: 0.4;\n    box-shadow: 0 0 4px rgba(0, 102, 255, 0.3);\n  }\n}\n\n/* Custom subtle scrollbar */\n::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n\n::-webkit-scrollbar-track {\n  background: #0A0A0B;\n}\n\n::-webkit-scrollbar-thumb {\n  background: #26262C;\n  border-radius: 3px;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: #0066FF;\n}\n"
    num_lines: 76
    num_bytes: 1581
  }
}
