      original_chunk {
        target_content: "        {/* Section Header */}\n        <div className=\"flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6\">\n          <div>\n            <p className=\"text-xs font-mono tracking-[0.2em] text-[#E50914] uppercase font-bold mb-3\">\n              PRODUCTION SPECIFICATIONS\n            </p>\n            <h2 className=\"text-3xl sm:text-5xl lg:text-6xl font-black font-display uppercase tracking-tight text-white leading-[0.95]\">\n              TAILORED TO<br />\n              <span className=\"text-[#E50914]\">YOUR EVENT.</span>\n            </h2>\n          </div>\n\n          <div className=\"flex flex-col items-start md:items-end space-y-2\">\n            <p className=\"text-xs font-mono text-zinc-400\">\n              No off-the-shelf templates. Every specification is custom engineered.\n            </p>\n            <button\n              onClick={() => setConfiguratorOpen(true)}\n              className=\"inline-flex items-center gap-2 px-4 py-2 bg-zinc-900 border border-zinc-700 text-xs font-mono font-bold text-white uppercase hover:bg-zinc-800 transition-colors cursor-pointer\"\n            >\n              <Sliders className=\"w-3.5 h-3.5 text-[#E50914]\" />\n              <span>LAUNCH PRODUCTION CONFIGURATOR</span>\n            </button>\n          </div>\n        </div>\n\n        {/* Service Levels Editorial Layout */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12\">\n          {SERVICE_LEVELS.map((level) => {\n            const isPopular = level.badge === \'MOST POPULAR\';\n            return (\n              <div\n                key={level.id}\n                className={`p-6 sm:p-8 rounded-lg border flex flex-col justify-between transition-all duration-300 relative ${\n                  isPopular\n                    ? \'bg-zinc-950 border-[#E50914] shadow-2xl ring-1 ring-[#E50914]\'\n                    : \'bg-zinc-950/80 border-zinc-800/90 hover:border-zinc-700\'\n                }`}\n              >\n                {isPopular && (\n                  <div className=\"absolute -top-3 left-1/2 -translate-x-1/2 bg-[#E50914] text-white text-[9px] font-mono font-bold px-3 py-0.5 uppercase tracking-widest rounded-full shadow-lg\">\n                    {level.badge}\n                  </div>\n                )}\n\n                <div className=\"space-y-6\">\n                  {/* Tier Title & Camera Count */}\n                  <div>\n                    <span className=\"text-xs font-mono text-zinc-500 uppercase tracking-widest font-bold\">\n                      TIER SPECIFICATION\n                    </span>\n                    <h3 className=\"text-2xl font-black font-display uppercase tracking-tight text-white mt-1\">\n                      {level.name}\n                    </h3>\n                    <div className=\"mt-2 inline-block px-3 py-1 bg-zinc-900 border border-zinc-800 rounded text-xs font-mono font-bold text-[#E50914]\">\n                      {level.cameraCount}\n                    </div>\n                  </div>\n\n                  <p className=\"text-xs text-zinc-400 font-normal leading-relaxed min-h-[40px]\">\n                    {level.suitableFor}\n                  </p>\n\n                  {/* Included Deliverables */}\n                  <div className=\"space-y-2.5 pt-4 border-t border-zinc-800/80\">\n                    <p className=\"text-[10px] font-mono uppercase tracking-widest text-zinc-400 font-bold\">\n                      INCLUDED IN SPECIFICATION:\n                    </p>\n                    {level.features.map((feature) => (\n                      <div key={feature} className=\"flex items-start gap-2 text-xs font-mono text-zinc-300\">\n                        <Check className=\"w-3.5 h-3.5 text-[#E50914] shrink-0 mt-0.5\" />\n                        <span className=\"leading-snug\">{feature}</span>\n                      </div>\n                    ))}\n                  </div>\n                </div>\n\n                {/* Bottom Action */}\n                <div className=\"pt-6 border-t border-zinc-800 mt-6\">\n                  <button\n                    onClick={() => onPlanProductionClick(level.name)}\n                    className={`w-full group inline-flex items-center justify-center gap-2 py-3 text-xs font-mono font-bold tracking-[0.15em] uppercase transition-all duration-200 cursor-pointer ${\n                      isPopular\n                        ? \'bg-[#E50914] text-white hover:bg-red-700 shadow-lg\'\n                        : \'bg-zinc-900 text-zinc-200 hover:bg-zinc-800 hover:text-white border border-zinc-800\'\n                    }`}\n                  >\n                    <span>BUILD MY PRODUCTION</span>\n                    <ArrowRight className=\"w-3.5 h-3.5 transition-transform group-hover:translate-x-1\" />\n                  </button>\n                </div>\n              </div>\n            );\n          })}\n        </div>\n\n        {/* Tailored Statement Notice */}\n        <div className=\"p-6 bg-zinc-950 border border-zinc-800 rounded-lg flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left\">\n          <div className=\"flex items-center gap-3\">\n            <ShieldCheck className=\"w-6 h-6 text-[#E50914] shrink-0\" />\n            <div>\n              <p className=\"text-sm font-display font-bold uppercase text-white tracking-wide\">\n                EVERY PRODUCTION IS TAILORED TO THE EVENT.\n              </p>\n              <p className=\"text-xs font-mono text-zinc-400 mt-0.5\">\n                We review venue acoustics, lighting, bandwidth, and camera angles before providing a final transparent proposal.\n              </p>\n            </div>\n          </div>\n\n          <button\n            onClick={() => onPlanProductionClick()}\n            className=\"shrink-0 px-6 py-3 bg-white text-black text-xs font-mono font-bold uppercase tracking-widest hover:bg-[#E50914] hover:text-white transition-colors cursor-pointer\"\n          >\n            BUILD MY PRODUCTION \342\206\222\n          </button>\n        </div>\n\n      </div>\n\n      {/* Production Configurator Interactive Drawer */}\n      <AnimatePresence>\n        {configuratorOpen && (\n          <motion.div\n            initial={{ opacity: 0 }}\n            animate={{ opacity: 1 }}\n            exit={{ opacity: 0 }}\n            className=\"fixed inset-0 z-50 bg-black/90 backdrop-blur-md p-4 sm:p-6 overflow-y-auto flex items-center justify-center\"\n          >\n            <motion.div\n              initial={{ scale: 0.95, y: 20 }}\n              animate={{ scale: 1, y: 0 }}\n              exit={{ scale: 0.95, y: 20 }}\n              className=\"bg-zinc-950 border border-zinc-800 rounded-lg max-w-2xl w-full p-6 sm:p-8 relative shadow-2xl space-y-6\"\n            >\n              <button\n                onClick={() => setConfiguratorOpen(false)}\n                className=\"absolute top-4 right-4 p-2 text-zinc-400 hover:text-white bg-zinc-900 rounded-full cursor-pointer\"\n              >\n                <X className=\"w-5 h-5\" />\n              </button>\n\n              <div className=\"space-y-1\">\n                <span className=\"text-xs font-mono text-[#E50914] uppercase font-bold tracking-widest\">\n                  INTERACTIVE CONFIGURATOR\n                </span>\n                <h3 className=\"text-2xl font-black font-display uppercase text-white\">\n                  CUSTOM PRODUCTION SPECIFICATION\n                </h3>\n              </div>\n\n              {/* Camera Slider */}\n              <div className=\"space-y-2 bg-zinc-900 p-4 rounded border border-zinc-800\">\n                <div className=\"flex justify-between items-center text-xs font-mono text-zinc-300\">\n                  <span className=\"font-bold uppercase\">CAMERAS REQUIRED</span>\n                  <span className=\"text-[#E50914] font-bold text-sm\">{customCamCount} CAMERAS</span>\n                </div>\n                <input\n                  type=\"range\"\n                  min=\"1\"\n                  max=\"8\"\n                  value={customCamCount}\n                  onChange={(e) => setCustomCamCount(Number(e.target.value))}\n                  className=\"w-full accent-[#E50914] cursor-pointer\"\n                />\n                <p className=\"text-[11px] font-mono text-zinc-400\">\n                  {customCamCount === 1 && \'Single operator stationary keynote camera.\'}\n                  {customCamCount >= 2 && customCamCount <= 3 && \'Wide stage angle + tight presenter tracking + PTZ audience camera.\'}\n                  {customCamCount >= 4 && customCamCount <= 5 && \'Full multi-angle coverage + wireless handheld gimbal + vision switcher crew.\'}\n                  {customCamCount >= 6 && \'Concert / Festival multi-camera rig with crane/jib & ISO recordings.\'}\n                </p>\n              </div>\n\n              {/* Streaming Destinations Slider */}\n              <div className=\"space-y-2 bg-zinc-900 p-4 rounded border border-zinc-800\">\n                <div className=\"flex justify-between items-center text-xs font-mono text-zinc-300\">\n                  <span className=\"font-bold uppercase\">STREAM DESTINATIONS</span>\n                  <span className=\"text-[#E50914] font-bold text-sm\">{customPlatforms} PLATFORMS</span>\n                </div>\n                <input\n                  type=\"range\"\n                  min=\"1\"\n                  max=\"5\"\n                  value={customPlatforms}\n                  onChange={(e) => setCustomPlatforms(Number(e.target.value))}\n                  className=\"w-full accent-[#E50914] cursor-pointer\"\n                />\n              </div>\n\n              {/* Toggles */}\n              <div className=\"grid grid-cols-2 gap-3\">\n                <label className=\"p-3 bg-zinc-900 border border-zinc-800 rounded flex items-center justify-between cursor-pointer\">\n                  <span className=\"text-xs font-mono text-zinc-300 font-bold uppercase\">LED WALL MAPPING</span>\n                  <input\n                    type=\"checkbox\"\n                    checked={needsLed}\n                    onChange={(e) => setNeedsLed(e.target.checked)}\n                    className=\"accent-[#E50914] w-4 h-4 cursor-pointer\"\n                  />\n                </label>\n\n                <label className=\"p-3 bg-zinc-900 border border-zinc-800 rounded flex items-center justify-between cursor-pointer\">\n                  <span className=\"text-xs font-mono text-zinc-300 font-bold uppercase\">ISO PRORES ARCHIVE</span>\n                  <input\n                    type=\"checkbox\"\n                    checked={needsISO}\n                    onChange={(e) => setNeedsISO(e.target.checked)}\n                    className=\"accent-[#E50914] w-4 h-4 cursor-pointer\"\n                  />\n                </label>\n              </div>\n\n              {/* Recommended Tier Summary */}\n              <div className=\"p-4 bg-[#E50914]/10 border border-[#E50914] rounded text-xs font-mono\">\n                <p className=\"text-[#E50914] font-bold uppercase mb-1\">RECOMMENDED BASE SPECIFICATION:</p>\n                <p className=\"text-white text-base font-display font-bold uppercase\">\n                  {customCamCount <= 2 ? \'STARTER PACKAGE\' : customCamCount <= 4 ? \'STANDARD PACKAGE\' : customCamCount <= 6 ? \'PREMIUM PACKAGE\' : \'GLOBAL ELITE PACKAGE\'}\n                </p>\n              </div>\n\n              <div className=\"flex justify-end gap-3 pt-2\">\n                <button\n                  onClick={() => setConfiguratorOpen(false)}\n                  className=\"px-4 py-2 bg-zinc-900 text-zinc-300 text-xs font-mono hover:text-white\"\n                >\n                  CANCEL\n                </button>\n                <button\n                  onClick={() => {\n                    setConfiguratorOpen(false);\n                    onPlanProductionClick(`Custom (${customCamCount} Cameras, ${customPlatforms} Platforms)`);\n                  }}\n                  className=\"px-6 py-2.5 bg-[#E50914] text-white text-xs font-mono font-bold uppercase tracking-wider hover:bg-red-700\"\n                >\n                  TRANSFER SPEC TO BRIEF \342\206\222\n                </button>\n              </div>"
        replacement_content: "        {/* Section Header */}\n        <div className=\"flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6\">\n          <div>\n            <p className=\"text-xs font-mono tracking-[0.2em] text-[#0066FF] uppercase font-bold mb-3\">\n              PRODUCTION SPECIFICATIONS\n            </p>\n            <h2 className=\"text-3xl sm:text-5xl lg:text-6xl font-black font-display uppercase tracking-tight text-white leading-[0.95]\">\n              TAILORED TO<br />\n              <span className=\"text-[#0066FF]\">YOUR EVENT.</span>\n            </h2>\n          </div>\n\n          <div className=\"flex flex-col items-start md:items-end space-y-2\">\n            <p className=\"text-xs font-mono text-zinc-400\">\n              No off-the-shelf templates. Every specification is custom engineered.\n            </p>\n            <button\n              onClick={() => setConfiguratorOpen(true)}\n              className=\"inline-flex items-center gap-2 px-4 py-2 bg-zinc-900 border border-zinc-700 text-xs font-mono font-bold text-white uppercase hover:bg-zinc-800 transition-colors cursor-pointer\"\n            >\n              <Sliders className=\"w-3.5 h-3.5 text-[#0066FF]\" />\n              <span>LAUNCH PRODUCTION CONFIGURATOR</span>\n            </button>\n          </div>\n        </div>\n\n        {/* Service Levels Editorial Layout */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12\">\n          {SERVICE_LEVELS.map((level) => {\n            const isPopular = level.badge === \'MOST POPULAR\';\n            return (\n              <div\n                key={level.id}\n                className={`p-6 sm:p-8 rounded-lg border flex flex-col justify-between transition-all duration-300 relative ${\n                  isPopular\n                    ? \'bg-zinc-950 border-[#0066FF] shadow-2xl ring-1 ring-[#0066FF]\'\n                    : \'bg-zinc-950/80 border-zinc-800/90 hover:border-zinc-700\'\n                }`}\n              >\n                {isPopular && (\n                  <div className=\"absolute -top-3 left-1/2 -translate-x-1/2 bg-[#0066FF] text-white text-[9px] font-mono font-bold px-3 py-0.5 uppercase tracking-widest rounded-full shadow-lg\">\n                    {level.badge}\n                  </div>\n                )}\n\n                <div className=\"space-y-6\">\n                  {/* Tier Title & Camera Count */}\n                  <div>\n                    <span className=\"text-xs font-mono text-zinc-500 uppercase tracking-widest font-bold\">\n                      TIER SPECIFICATION\n                    </span>\n                    <h3 className=\"text-2xl font-black font-display uppercase tracking-tight text-white mt-1\">\n                      {level.name}\n                    </h3>\n                    <div className=\"mt-2 inline-block px-3 py-1 bg-zinc-900 border border-zinc-800 rounded text-xs font-mono font-bold text-[#0066FF]\">\n                      {level.cameraCount}\n                    </div>\n                  </div>\n\n                  <p className=\"text-xs text-zinc-400 font-normal leading-relaxed min-h-[40px]\">\n                    {level.suitableFor}\n                  </p>\n\n                  {/* Included Deliverables */}\n                  <div className=\"space-y-2.5 pt-4 border-t border-zinc-800/80\">\n                    <p className=\"text-[10px] font-mono uppercase tracking-widest text-zinc-400 font-bold\">\n                      INCLUDED IN SPECIFICATION:\n                    </p>\n                    {level.features.map((feature) => (\n                      <div key={feature} className=\"flex items-start gap-2 text-xs font-mono text-zinc-300\">\n                        <Check className=\"w-3.5 h-3.5 text-[#0066FF] shrink-0 mt-0.5\" />\n                        <span className=\"leading-snug\">{feature}</span>\n                      </div>\n                    ))}\n                  </div>\n                </div>\n\n                {/* Bottom Action */}\n                <div className=\"pt-6 border-t border-zinc-800 mt-6\">\n                  <button\n                    onClick={() => onPlanProductionClick(level.name)}\n                    className={`w-full group inline-flex items-center justify-center gap-2 py-3 text-xs font-mono font-bold tracking-[0.15em] uppercase transition-all duration-200 cursor-pointer ${\n                      isPopular\n                        ? \'bg-[#0066FF] text-white hover:bg-blue-600 shadow-lg\'\n                        : \'bg-zinc-900 text-zinc-200 hover:bg-zinc-800 hover:text-white border border-zinc-800\'\n                    }`}\n                  >\n                    <span>BUILD MY PRODUCTION</span>\n                    <ArrowRight className=\"w-3.5 h-3.5 transition-transform group-hover:translate-x-1\" />\n                  </button>\n                </div>\n              </div>\n            );\n          })}\n        </div>\n\n        {/* Tailored Statement Notice */}\n        <div className=\"p-6 bg-zinc-950 border border-zinc-800 rounded-lg flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left\">\n          <div className=\"flex items-center gap-3\">\n            <ShieldCheck className=\"w-6 h-6 text-[#0066FF] shrink-0\" />\n            <div>\n              <p className=\"text-sm font-display font-bold uppercase text-white tracking-wide\">\n                EVERY PRODUCTION IS TAILORED TO THE EVENT.\n              </p>\n              <p className=\"text-xs font-mono text-zinc-400 mt-0.5\">\n                We review venue acoustics, lighting, bandwidth, and camera angles before providing a final transparent proposal.\n              </p>\n            </div>\n          </div>\n\n          <button\n            onClick={() => onPlanProductionClick()}\n            className=\"shrink-0 px-6 py-3 bg-white text-black text-xs font-mono font-bold uppercase tracking-widest hover:bg-[#0066FF] hover:text-white transition-colors cursor-pointer\"\n          >\n            BUILD MY PRODUCTION \342\206\222\n          </button>\n        </div>\n\n      </div>\n\n      {/* Production Configurator Interactive Drawer */}\n      <AnimatePresence>\n        {configuratorOpen && (\n          <motion.div\n            initial={{ opacity: 0 }}\n            animate={{ opacity: 1 }}\n            exit={{ opacity: 0 }}\n            className=\"fixed inset-0 z-50 bg-black/90 backdrop-blur-md p-4 sm:p-6 overflow-y-auto flex items-center justify-center\"\n          >\n            <motion.div\n              initial={{ scale: 0.95, y: 20 }}\n              animate={{ scale: 1, y: 0 }}\n              exit={{ scale: 0.95, y: 20 }}\n              className=\"bg-zinc-950 border border-zinc-800 rounded-lg max-w-2xl w-full p-6 sm:p-8 relative shadow-2xl space-y-6\"\n            >\n              <button\n                onClick={() => setConfiguratorOpen(false)}\n                className=\"absolute top-4 right-4 p-2 text-zinc-400 hover:text-white bg-zinc-900 rounded-full cursor-pointer\"\n              >\n                <X className=\"w-5 h-5\" />\n              </button>\n\n              <div className=\"space-y-1\">\n                <span className=\"text-xs font-mono text-[#0066FF] uppercase font-bold tracking-widest\">\n                  INTERACTIVE CONFIGURATOR\n                </span>\n                <h3 className=\"text-2xl font-black font-display uppercase text-white\">\n                  CUSTOM PRODUCTION SPECIFICATION\n                </h3>\n              </div>\n\n              {/* Camera Slider */}\n              <div className=\"space-y-2 bg-zinc-900 p-4 rounded border border-zinc-800\">\n                <div className=\"flex justify-between items-center text-xs font-mono text-zinc-300\">\n                  <span className=\"font-bold uppercase\">CAMERAS REQUIRED</span>\n                  <span className=\"text-[#0066FF] font-bold text-sm\">{customCamCount} CAMERAS</span>\n                </div>\n                <input\n                  type=\"range\"\n                  min=\"1\"\n                  max=\"8\"\n                  value={customCamCount}\n                  onChange={(e) => setCustomCamCount(Number(e.target.value))}\n                  className=\"w-full accent-[#0066FF] cursor-pointer\"\n                />\n                <p className=\"text-[11px] font-mono text-zinc-400\">\n                  {customCamCount === 1 && \'Single operator stationary keynote camera.\'}\n                  {customCamCount >= 2 && customCamCount <= 3 && \'Wide stage angle + tight presenter tracking + PTZ audience camera.\'}\n                  {customCamCount >= 4 && customCamCount <= 5 && \'Full multi-angle coverage + wireless handheld gimbal + vision switcher crew.\'}\n                  {customCamCount >= 6 && \'Concert / Festival multi-camera rig with crane/jib & ISO recordings.\'}\n                </p>\n              </div>\n\n              {/* Streaming Destinations Slider */}\n              <div className=\"space-y-2 bg-zinc-900 p-4 rounded border border-zinc-800\">\n                <div className=\"flex justify-between items-center text-xs font-mono text-zinc-300\">\n                  <span className=\"font-bold uppercase\">STREAM DESTINATIONS</span>\n                  <span className=\"text-[#0066FF] font-bold text-sm\">{customPlatforms} PLATFORMS</span>\n                </div>\n                <input\n                  type=\"range\"\n                  min=\"1\"\n                  max=\"5\"\n                  value={customPlatforms}\n                  onChange={(e) => setCustomPlatforms(Number(e.target.value))}\n                  className=\"w-full accent-[#0066FF] cursor-pointer\"\n                />\n              </div>\n\n              {/* Toggles */}\n              <div className=\"grid grid-cols-2 gap-3\">\n                <label className=\"p-3 bg-zinc-900 border border-zinc-800 rounded flex items-center justify-between cursor-pointer\">\n                  <span className=\"text-xs font-mono text-zinc-300 font-bold uppercase\">LED WALL MAPPING</span>\n                  <input\n                    type=\"checkbox\"\n                    checked={needsLed}\n                    onChange={(e) => setNeedsLed(e.target.checked)}\n                    className=\"accent-[#0066FF] w-4 h-4 cursor-pointer\"\n                  />\n                </label>\n\n                <label className=\"p-3 bg-zinc-900 border border-zinc-800 rounded flex items-center justify-between cursor-pointer\">\n                  <span className=\"text-xs font-mono text-zinc-300 font-bold uppercase\">ISO PRORES ARCHIVE</span>\n                  <input\n                    type=\"checkbox\"\n                    checked={needsISO}\n                    onChange={(e) => setNeedsISO(e.target.checked)}\n                    className=\"accent-[#0066FF] w-4 h-4 cursor-pointer\"\n                  />\n                </label>\n              </div>\n\n              {/* Recommended Tier Summary */}\n              <div className=\"p-4 bg-[#0066FF]/10 border border-[#0066FF] rounded text-xs font-mono\">\n                <p className=\"text-[#0066FF] font-bold uppercase mb-1\">RECOMMENDED BASE SPECIFICATION:</p>\n                <p className=\"text-white text-base font-display font-bold uppercase\">\n                  {customCamCount <= 2 ? \'STARTER PACKAGE\' : customCamCount <= 4 ? \'STANDARD PACKAGE\' : customCamCount <= 6 ? \'PREMIUM PACKAGE\' : \'GLOBAL ELITE PACKAGE\'}\n                </p>\n              </div>\n\n              <div className=\"flex justify-end gap-3 pt-2\">\n                <button\n                  onClick={() => setConfiguratorOpen(false)}\n                  className=\"px-4 py-2 bg-zinc-900 text-zinc-300 text-xs font-mono hover:text-white\"\n                >\n                  CANCEL\n                </button>\n                <button\n                  onClick={() => {\n                    setConfiguratorOpen(false);\n                    onPlanProductionClick(`Custom (${customCamCount} Cameras, ${customPlatforms} Platforms)`);\n                  }}\n                  className=\"px-6 py-2.5 bg-[#0066FF] text-white text-xs font-mono font-bold uppercase tracking-wider hover:bg-blue-600 transition-colors\"\n                >\n                  TRANSFER SPEC TO BRIEF \342\206\222\n                </button>\n              </div>"
      }
      num_matches: 1
    }
  }
}
