        target_content: "import React from \'react\';\n\ninterface LogoProps {\n  className?: string;\n  showTagline?: boolean;\n  variant?: \'full\' | \'mark-only\' | \'compact\';\n  lightText?: boolean;\n}\n\nexport const Logo: React.FC<LogoProps> = ({\n  className = \'\',\n  showTagline = false,\n  variant = \'full\',\n  lightText = true,\n}) => {\n  return (\n    <div className={`inline-flex flex-col items-start select-none ${className}`}>\n      <div className=\"flex items-center gap-2.5\">\n        {/* Official D1 Emblem geometry */}\n        <div className=\"relative flex items-center justify-center shrink-0\">\n          <svg\n            width=\"38\"\n            height=\"32\"\n            viewBox=\"0 0 48 40\"\n            fill=\"none\"\n            xmlns=\"http://www.w3.org/2000/svg\"\n            className=\"transition-transform duration-300 group-hover:scale-105\"\n          >\n            {/* Geometric \"D\" block */}\n            <path\n              d=\"M4 4H22C31.9411 4 40 11.1634 40 20C40 28.8366 31.9411 36 22 36H4V4Z\"\n              fill={lightText ? \'#FFFFFF\' : \'#0A0A0B\'}\n            />\n            {/* Inner negative space cut of \"D\" */}\n            <path\n              d=\"M14 12H21C26.5228 12 30 15.5817 30 20C30 24.4183 26.5228 28 21 28H14V12Z\"\n              fill=\"#0A0A0B\"\n            />\n            {/* Sharp integrated \"1\" block with vibrant broadcast red signal */}\n            <path\n              d=\"M40 4H46V36H40V4Z\"\n              fill=\"#E50914\"\n            />\n            {/* Broadcast tally dot */}\n            <circle cx=\"43\" cy=\"8\" r=\"2.5\" fill=\"#FF4D4D\" className=\"animate-pulse\" />\n          </svg>\n        </div>\n\n        {variant !== \'mark-only\' && (\n          <div className=\"flex flex-col leading-none\">\n            <div className=\"flex items-baseline gap-1.5\">\n              <span\n                className={`font-black tracking-[-0.03em] text-xl md:text-2xl font-display ${\n                  lightText ? \'text-white\' : \'text-slate-900\'\n                }`}\n              >\n                D1\n              </span>\n              <span\n                className={`font-bold tracking-[0.22em] text-base md:text-lg uppercase ${\n                  lightText ? \'text-zinc-200\' : \'text-slate-800\'\n                }`}\n              >\n                STREAMS\n              </span>\n            </div>\n            {variant === \'full\' && (\n              <div className=\"flex items-center gap-1.5 mt-0.5\">\n                <span className=\"inline-block w-1.5 h-1.5 rounded-full bg-[#E50914] tally-live-pulse\" />\n                <span className=\"text-[9px] font-mono tracking-[0.2em] text-zinc-400 uppercase\">\n                  BROADCAST MEDIA\n                </span>\n              </div>\n            )}\n          </div>\n        )}\n      </div>\n\n      {showTagline && (\n        <p className=\"mt-1.5 text-[10px] font-mono tracking-[0.18em] text-zinc-400 uppercase\">\n          BROADCAST QUALITY. ANYWHERE. ANYTIME.\n        </p>\n      )}\n    </div>\n  );\n};"
        replacement_content: "import React from \'react\';\n\ninterface LogoProps {\n  className?: string;\n  showTagline?: boolean;\n  variant?: \'full\' | \'mark-only\' | \'compact\';\n  lightText?: boolean;\n}\n\nexport const Logo: React.FC<LogoProps> = ({\n  className = \'\',\n  showTagline = false,\n  variant = \'full\',\n  lightText = true,\n}) => {\n  return (\n    <div className={`inline-flex flex-col items-start select-none ${className}`}>\n      <div className=\"flex items-center gap-3\">\n        {/* Official D1 Brand Emblem SVG */}\n        <div className=\"relative flex items-center justify-center shrink-0\">\n          <svg\n            width=\"44\"\n            height=\"36\"\n            viewBox=\"0 0 110 90\"\n            fill=\"none\"\n            xmlns=\"http://www.w3.org/2000/svg\"\n            className=\"transition-transform duration-300 group-hover:scale-105 filter drop-shadow-[0_2px_8px_rgba(0,102,255,0.3)]\"\n          >\n            <defs>\n              {/* Metallic Silver Gradient for \'D\' */}\n              <linearGradient id=\"silverDGrad\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n                <stop offset=\"0%\" stopColor=\"#CBD5E1\" />\n                <stop offset=\"50%\" stopColor=\"#94A3B8\" />\n                <stop offset=\"100%\" stopColor=\"#475569\" />\n              </linearGradient>\n\n              {/* Electric Blue Gradient for \'1\' */}\n              <linearGradient id=\"blue1Grad\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n                <stop offset=\"0%\" stopColor=\"#00A3FF\" />\n                <stop offset=\"60%\" stopColor=\"#0066FF\" />\n                <stop offset=\"100%\" stopColor=\"#0040C8\" />\n              </linearGradient>\n\n              {/* Cyan Pulse Gradient */}\n              <linearGradient id=\"cyanPulseGrad\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n                <stop offset=\"0%\" stopColor=\"#00E5FF\" />\n                <stop offset=\"100%\" stopColor=\"#0066FF\" />\n              </linearGradient>\n            </defs>\n\n            {/* Stylized \'D\' in metallic silver with open back & sleek curve */}\n            <path\n              d=\"M 12 18 L 38 18 C 54 18 64 27 64 45 C 64 63 54 72 38 72 L 12 72 L 20 58 L 36 58 C 45 58 50 52 50 45 C 50 38 45 32 36 32 L 20 32 Z\"\n              fill=\"url(#silverDGrad)\"\n            />\n\n            {/* Audio Pulse Waveform running through the \'D\' */}\n            <path\n              d=\"M 2 45 L 24 45 L 28 32 L 32 58 L 36 38 L 40 50 L 44 45 L 68 45\"\n              stroke=\"url(#cyanPulseGrad)\"\n              strokeWidth=\"4.5\"\n              strokeLinecap=\"round\"\n              strokeLinejoin=\"round\"\n            />\n\n            {/* Slanted Arrowhead \'1\' in Vibrant Electric Blue */}\n            <path\n              d=\"M 72 82 L 86 12 L 102 8 L 86 82 Z\"\n              fill=\"url(#blue1Grad)\"\n            />\n            {/* Top slanted flare cap of \'1\' */}\n            <path\n              d=\"M 68 36 L 86 12 L 102 8 Z\"\n              fill=\"#00D4FF\"\n              opacity=\"0.9\"\n            />\n          </svg>\n        </div>\n\n        {variant !== \'mark-only\' && (\n          <div className=\"flex flex-col leading-none\">\n            <div className=\"flex items-baseline font-display\">\n              {/* \"D\" in silver */}\n              <span\n                className={`font-black italic text-2xl md:text-3xl tracking-tight ${\n                  lightText ? \'text-slate-200\' : \'text-slate-900\'\n                }`}\n              >\n                D\n              </span>\n              {/* \"1\" in electric blue */}\n              <span className=\"font-black italic text-2xl md:text-3xl tracking-tight text-[#0066FF] mr-2\">\n                1\n              </span>\n              {/* \"STREAMS\" in expanded italic silver text */}\n              <span\n                className={`font-black italic tracking-[0.18em] text-lg md:text-xl uppercase ${\n                  lightText ? \'text-white\' : \'text-slate-800\'\n                }`}\n              >\n                STREAMS\n              </span>\n            </div>\n\n            {variant === \'full\' && (\n              <div className=\"flex items-center gap-1.5 mt-1\">\n                <span className=\"inline-block w-1.5 h-1.5 rounded-full bg-[#0066FF] tally-live-pulse\" />\n                <span className=\"text-[9px] font-mono tracking-[0.22em] text-zinc-400 uppercase font-semibold\">\n                  BROADCAST MEDIA\n                </span>\n              </div>\n            )}\n          </div>\n        )}\n      </div>\n\n      {showTagline && (\n        <p className=\"mt-2 text-[10px] font-mono tracking-[0.2em] italic text-zinc-400 uppercase font-semibold\">\n          BROADCAST QUALITY. ANYWHERE. ANYTIME.\n        </p>\n      )}\n    </div>\n  );\n};"
