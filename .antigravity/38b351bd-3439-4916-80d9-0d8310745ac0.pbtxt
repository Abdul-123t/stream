    content: "      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n        \n        {/* Section Header */}\n        <div className=\"mb-14 space-y-3\">\n          <div className=\"inline-flex items-center gap-2 px-3 py-1 bg-zinc-900 border border-zinc-800 text-[11px] font-mono tracking-[0.2em] text-[#0066FF] uppercase font-bold\">\n            <Radio className=\"w-3.5 h-3.5 animate-pulse\" />\n            <span>PROVEN DELIVERIES</span>\n          </div>\n\n          <h2 className=\"text-3xl sm:text-5xl lg:text-6xl font-black font-display uppercase tracking-tight text-white leading-[0.95]\">\n            RECENT PRODUCTION WORK\n          </h2>\n\n          <p className=\"text-sm sm:text-base text-zinc-400 font-normal max-w-2xl leading-relaxed\">\n            Trusted to deliver professional live production across churches, events and large-scale gatherings.\n          </p>\n        </div>\n\n        {/* 3 Featured Recent Locations */}\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6 mb-12\">\n          {recentWork.map((location, idx) => ("
    raw_content: "import React from \'react\';\nimport { Building2, Radio, CheckCircle2, Shield } from \'lucide-react\';\n\nexport const Testimonials: React.FC = () => {\n  const recentWork = [\n    {\n      name: \'RCCG JESUS PALACE\',\n      badge: \'Recent Production\',\n      category: \'Churches & Worship Events\',\n    },\n    {\n      name: \'RCCG ZONE OF RESURRECTION\',\n      badge: \'Recent Production\',\n      category: \'Churches & Worship Events\',\n    },\n    {\n      name: \'RCCG PEACE ARENA\',\n      badge: \'Recent Production\',\n      category: \'Churches & Worship Events\',\n    },\n  ];\n\n  return (\n    <section className=\"py-24 bg-[#F2F1EC] text-[#111216] border-b border-zinc-300 relative overflow-hidden\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n        \n        {/* Section Header */}\n        <div className=\"mb-14 space-y-3\">\n          <div className=\"inline-flex items-center gap-2 px-3 py-1 bg-zinc-900 border border-zinc-800 text-[11px] font-mono tracking-[0.2em] text-[#0066FF] uppercase font-bold\">\n            <Radio className=\"w-3.5 h-3.5 animate-pulse\" />\n            <span>PROVEN DELIVERIES</span>\n          </div>\n\n          <h2 className=\"text-3xl sm:text-5xl lg:text-6xl font-black font-display uppercase tracking-tight text-white leading-[0.95]\">\n            RECENT PRODUCTION WORK\n          </h2>\n\n          <p className=\"text-sm sm:text-base text-zinc-400 font-normal max-w-2xl leading-relaxed\">\n            Trusted to deliver professional live production across churches, events and large-scale gatherings.\n          </p>\n        </div>\n\n        {/* 3 Featured Recent Locations */}\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6 mb-12\">\n          {recentWork.map((location, idx) => (\n            <div\n              key={idx}\n              className=\"bg-zinc-950 border border-zinc-800/90 p-8 rounded-lg flex flex-col justify-between space-y-6 relative group hover:border-[#0066FF]/60 transition-all duration-300 shadow-xl\"\n            >\n              <div className=\"space-y-4\">\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"text-[10px] font-mono font-bold text-[#0066FF] uppercase tracking-widest px-2.5 py-1 bg-[#0066FF]/10 border border-[#0066FF]/30 rounded\">\n                    {location.badge}\n                  </span>\n                  <span className=\"text-xs font-mono text-zinc-600 font-bold\">\n                    0{idx + 1}\n                  </span>\n                </div>\n\n                <div className=\"p-3.5 bg-zinc-900 border border-zinc-800 rounded-md w-fit text-white group-hover:border-[#0066FF] transition-colors\">\n                  <Building2 className=\"w-6 h-6 text-[#0066FF]\" />\n                </div>\n\n                <div>\n                  <h3 className=\"text-xl font-black font-display uppercase tracking-tight text-white group-hover:text-[#0066FF] transition-colors\">\n                    {location.name}\n                  </h3>\n                  <p className=\"text-xs font-mono text-zinc-400 uppercase tracking-wider mt-1.5\">\n                    {location.category}\n                  </p>\n                </div>\n              </div>\n\n              <div className=\"pt-4 border-t border-zinc-800/80 flex items-center justify-between text-[11px] font-mono text-zinc-400\">\n                <span className=\"flex items-center gap-1.5 text-emerald-400\">\n                  <CheckCircle2 className=\"w-3.5 h-3.5\" />\n                  VERIFIED DEPLOYMENT\n                </span>\n                <span className=\"text-zinc-400 font-bold\">LIVE STREAM & BROADCAST</span>\n              </div>\n            </div>\n          ))}\n        </div>\n\n        {/* Optional Short Credibility Statement Banner */}\n        <div className=\"p-6 bg-zinc-950 border border-zinc-800 rounded-lg flex flex-col sm:flex-row items-center justify-between gap-6 text-center sm:text-left shadow-lg\">\n          <div className=\"flex items-center gap-4\">\n            <div className=\"p-3 bg-zinc-900 border border-zinc-800 rounded text-[#0066FF] shrink-0 hidden sm:block\">\n              <Shield className=\"w-5 h-5 text-[#0066FF]\" />\n            </div>\n            <div>\n              <p className=\"text-xs font-mono tracking-widest text-[#0066FF] uppercase font-bold\">\n                PRODUCTION INTEGRITY & EXPERIENCE\n              </p>\n              <p className=\"text-sm font-mono font-bold text-white uppercase mt-0.5\">\n                RECENTLY DELIVERING LIVE PRODUCTION FOR CHURCHES, EVENTS AND LARGE-SCALE GATHERINGS.\n              </p>\n            </div>\n          </div>\n\n          <span className=\"text-[11px] font-mono text-zinc-400 uppercase tracking-wider px-3.5 py-2 bg-zinc-900 border border-zinc-800 rounded shrink-0\">\n            CONFIDENTIAL & PROFESSIONAL STANDARDS\n          </span>\n        </div>\n\n      </div>\n    </section>\n  );\n};\n"
    num_lines: 110
    num_bytes: 4837
  }
}
