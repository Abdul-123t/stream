    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { CapabilityItem, ProcessStep, EventCategory, ServiceLevel, FAQItem } from \'./types\';\n\nexport const CAPABILITIES: CapabilityItem[] = [\n  {\n    id: \'multi-camera\',\n    title: \'MULTI-CAMERA PRODUCTION\',\n    shortDesc: \'Professional multi-camera coverage designed to capture the event from multiple perspectives.\',\n    fullDesc: \'From 2-camera talk setups to 8+ camera live concert rigs, our multi-camera systems utilize Sony FX6 / FX3 and Blackmagic URSA Broadcast 4K cameras with motorized PTZ robotics, wireless video transmitters, and cinema lenses to capture every nuance of your live event.\',\n    specs: [\'4K / 1080p60 Uncompressed Capture\', \'NDI & 12G-SDI Signal Infrastructure\', \'Wireless Teradek Zero-Delay Transmission\', \'Symphonic Zoom & Prime Lenses\'],\n    equipment: [\'Sony Cinema Line Cameras\', \'Blackmagic Broadcast Systems\', \'Canon Broadcast Lenses\', \'DJI Ronin Stabilizers\'],\n    icon: \'Video\',\n    image: \'https://images.unsplash.com/photo-1594909122845-11baa439b7bf?q=80&w=1200&auto=format&fit=crop\',\n  },\n  {\n    id: \'live-switching\',\n    title: \'LIVE SWITCHING\',\n    shortDesc: \'Real-time vision mixing and camera direction for dynamic broadcast-quality coverage.\',\n    fullDesc: \'Our technical directors execute seamless vision mixing on Blackmagic ATEM Constellation and Ross Video switchers. We deliver instant instant-replay, live multi-view monitoring, chroma keying, and multi-destination program feeds tailored for both online viewers and venue LED displays.\',\n    specs: [\'20-Input 4K ATEM Constellation Mixers\', \'Ultra-low Latency Hardware Switching\', \'Hardware Instant Replay Systems\', \'ISO Recording Per Input\'],\n    equipment: [\'Blackmagic ATEM 4 M/E Constellation\', \'vMix Pro 4K Systems\', \'Elgato Stream Deck XL Arrays\', \'Multi-Viewer Field Monitors\'],\n    icon: \'Sliders\',\n    image: \'https://images.unsplash.com/photo-1516321318423-f06f85e504b3?q=80&w=1200&auto=format&fit=crop\',\n  },\n  {\n    id: \'broadcast-audio\',\n    title: \'BROADCAST AUDIO\',\n    shortDesc: \'Professional audio integration designed to deliver clear, balanced sound to the online audience.\',\n    fullDesc: \'Concert and conference audio online often suffers from poor mixing. We deploy Dante digital audio networks, Behringer X32 / Allen & Heath SQ consoles, automixing for keynote speakers, and mastering compressors to ensure speech and musical performances sound album-ready.\',\n    specs: [\'Dante & MADI Digital Audio Protocols\', \'EBU R128 Loudness Compliance (-14 LUFS)\', \'Automixed Keynote Wireless Mics\', \'Multitrack Raw Audio Recording\'],\n    equipment: [\'Allen & Heath SQ-6 Digital Mixers\', \'Shure Axient Digital Wireless Systems\', \'Neumann & Sennheiser Microphones\', \'Waves Live Audio Processing\'],\n    icon: \'Volume2\',\n    image: \'https://images.unsplash.com/photo-1598488035139-bdbb2231ce04?q=80&w=1200&auto=format&fit=crop\',\n  },\n  {\n    id: \'graphics-overlays\',\n    title: \'GRAPHICS & OVERLAYS\',\n    shortDesc: \'Branded titles, lower thirds, transitions and live visual systems.\',\n    fullDesc: \'Elevate your stream with broadcast-grade graphics. We create custom animated lower thirds, speaker title cards, live lower-third scoreboards, real-time audience polling, QR code overlays, and sponsor placement cards synced with your event branding.\',\n    specs: [\'Alpha Channel Transparent Video Motion\', \'Dynamic Data-Driven Speaker Labels\', \'Real-Time Audience Polling Overlays\', \'Custom Stinger Transitions\'],\n    equipment: [\'vMix Graphic Engines\', \'Singular.live Cloud Graphics\', \'Adobe After Effects Render Rigs\', \'Custom HTML5 Data Overlays\'],\n    icon: \'Layers\',\n    image: \'https://images.unsplash.com/photo-1550745165-9bc0b252726f?q=80&w=1200&auto=format&fit=crop\',\n  },\n  {\n    id: \'multi-platform\',\n    title: \'MULTI-PLATFORM STREAMING\',\n    shortDesc: \'Stream simultaneously to YouTube, Facebook, Instagram, Twitch or custom RTMP destinations.\',\n    fullDesc: \'Reach your audience wherever they gather. Using hardware bonded cellular transceivers (LiveU / Peplink) and redundant cloud distribution servers, we push pristine 1080p or 4K streams concurrently to YouTube, LinkedIn, X, Facebook, and custom private portals.\',\n    specs: [\'Bonded 5G / Starlink Satellite Connectivity\', \'SRT & Custom Secure RTMP / RTMPS\', \'Concurrent 10+ Destination Distribution\', \'Failover Redundant Signal Paths\'],\n    equipment: [\'LiveU Live Streaming Encoders\', \'Peplink SpeedFusion SD-WAN\', \'Resi High-Reliability Encoders\', \'Teradek Prism Flex 4K\'],\n    icon: \'Globe\',\n    image: \'https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?q=80&w=1200&auto=format&fit=crop\',\n  },\n  {\n    id: \'onsite-production\',\n    title: \'ON-SITE PRODUCTION\',\n    shortDesc: \'Technical direction and experienced production crew managing the live workflow.\',\n    fullDesc: \'We supply complete, seasoned crews \342\200\224 including Technical Directors, Vision Mixers, Camera Operators, Audio Engineers, Graphics Operators, and Floor Managers. Our crew handles load-in, rig testing, comms setup, live execution, and load-out smoothly.\',\n    specs: [\'Dedicated Technical Director & Crew\', \'Clear-Com Wireless Intercom Matrix\', \'Full Redundancy Power & UPS Backups\', \'Comprehensive Site Safety Protocol\'],\n    equipment: [\'Hollyland Mars T1000 Intercoms\', \'APC Smart-UPS Pro Backup Power\', \'Modular Flightcase Racks\', \'Broadcast Monitoring Station\'],\n    icon: \'Users\',\n    image: \'https://images.unsplash.com/photo-1492684223066-81342ee5ff30?q=80&w=1200&auto=format&fit=crop\',\n  },\n  {\n    id: \'led-hybrid\',\n    title: \'LED & HYBRID PRODUCTION\',\n    shortDesc: \'Integration with LED environments, presentations and hybrid event systems.\',\n    fullDesc: \'Synchronize on-site LED walls, stage monitors, and remote Zoom/Teams presenters with the broadcast stream. We manage low-latency return video feeds, remote speaker green rooms, and venue presentation switching so both physical and virtual attendees share the same experience.\',\n    specs: [\'LED Video Wall Signal Mapping\', \'Low-Latency Speaker Return Video\', \'Bidirectional Zoom / Teams Integration\', \'Presenter Prompting & Countdown Clocks\'],\n    equipment: [\'Novastar LED Processors\', \'Barco Master Video Switchers\', \'Broadcast Teleprompter Kits\', \'Low-latency SRT Return Monitors\'],\n    icon: \'Monitor\',\n    image: \'https://images.unsplash.com/photo-1540575467063-178a50c2df87?q=80&w=1200&auto=format&fit=crop\',\n  },\n  {\n    id: \'recording-archive\',\n    title: \'RECORDING & ARCHIVE\',\n    shortDesc: \'Reliable local recording and archival so the production can continue beyond the livestream.\',\n    fullDesc: \'Never lose a second of your event. We record isolated (ISO) feeds for every camera plus master program feeds in Apple ProRes 422 / DNxHR to NVMe RAID storage, delivering instant post-event media archives and highlight reels ready for editing.\',\n    specs: [\'Isolated ISO Camera Feeds + Program Master\', \'Apple ProRes 422 / H.265 High Bitrate\', \'Dual-NVMe RAID Redundant Backup\', \'Immediate Same-Day File Handoff\'],\n    equipment: [\'Blackmagic HyperDeck Studio 4K\', \'Atomos Sumo 19\" HDR Recorders\', \'SanDisk Professional RAID Drives\', \'High-speed Cloud Ingestion Server\'],\n    icon: \'Database\',\n    image: \'https://images.unsplash.com/photo-1478760329108-5c3ed9d495a0?q=80&w=1200&auto=format&fit=crop\',\n  },\n];\n\nexport const PROCESS_STEPS: ProcessStep[] = [\n  {\n    number: \'01\',\n    title: \'UNDERSTAND\',\n    description: \'We understand your event, audience, venue, schedule and production requirements.\',\n    keyActivity: \'Comprehensive briefing & venue technical assessment\',\n    deliverables: [\'Production Brief\', \'Venue Site Survey\', \'Signal Path Audit\', \'Audience Reach Map\'],\n  },\n  {\n    number: \'02\',\n    title: \'PLAN\',\n    description: \'We design the production workflow, camera configuration, streaming architecture and technical requirements.\',\n    keyActivity: \'System architecture, floor plans, and run-of-show scheduling\',\n    deliverables: [\'Camera Placement Diagram\', \'Bandwidth & Network Plan\', \'Graphics Asset Template\', \'Run of Show Schedule\'],\n  },\n  {\n    number: \'03\',\n    title: \'PRODUCE\',\n    description: \'Our crew manages the live production, switching, audio, graphics and broadcast workflow.\',\n    keyActivity: \'On-site rig setup, rehearsal, and flawless live execution\',\n    deliverables: [\'Live Multi-Cam Switching\', \'Broadcast Audio Mixing\', \'Real-Time Graphics Injection\', \'Multi-Viewer Monitoring\'],\n  },\n  {\n    number: \'04\',\n    title: \'DELIVER\',\n    description: \'Your broadcast reaches audiences across the platforms that matter.\',\n    keyActivity: \'Redundant multi-destination streaming with zero dropouts\',\n    deliverables: [\'Simulcast Platform Streams\', \'Private Client Video Portal\', \'Live Stream Telemetry Log\', \'Viewer Engagement Analytics\'],\n  },\n  {\n    number: \'05\',\n    title: \'ARCHIVE\',\n    description: \'Where required, the production is recorded and preserved for future use.\',\n    keyActivity: \'Master ProRes archiving & instant media handoff\',\n    deliverables: [\'High-Bitrate Program Master\', \'Individual ISO Camera Footage\', \'Multitrack Audio Files\', \'Cloud Archival Access\'],\n  },\n];\n\nexport const EVENT_CATEGORIES: EventCategory[] = [\n  {\n    id: \'conferences\',\n    title: \'CONFERENCES & SUMMITS\',\n    description: \'Multi-stage keynote capture, presentation graphics, remote Q&A, and high-definition hybrid attendee streaming for global corporate assemblies.\',\n    image: \'https://images.unsplash.com/photo-1540575467063-178a50c2df87?q=80&w=1200&auto=format&fit=crop\',\n    cameraSetup: \'3-6 Cameras (Wide, Keynote Tight, Audience, Stage Tracking)\',\n    keyRequirements: [\'Automixed Wireless Mics\', \'Presenter Slide Capture\', \'Low-latency SRT Return\'],\n  },\n  {\n    id: \'concerts\',\n    title: \'CONCERTS & FESTIVALS\',\n    description: \'High-energy musical performances captured with dynamic camera movement, pristine multitrack audio mixing, and immersive stage lighting integration.\',\n    image: \'https://images.unsplash.com/photo-1470225620780-dba8ba36b745?q=80&w=1200&auto=format&fit=crop\',\n    cameraSetup: \'4-8 Cameras (FOH Wide, Jib Crane, Pit Handhelds, Stage Robotic PTZ)\',\n    keyRequirements: [\'Dante Concert Audio Feed\', \'Stage Stinger Graphics\', \'4K ISO Camera Recording\'],\n  },\n  {\n    id: \'churches\',\n    title: \'CHURCHES & MINISTRIES\',\n    description: \'Reverent, immersive live worship broadcasts connecting global congregations with crystal-clear acoustics, lower-third scripture lyrics, and reliable weekly scheduling.\',\n    image: \'https://images.unsplash.com/photo-1438232992991-995b7058bbb3?q=80&w=1200&auto=format&fit=crop\',\n    cameraSetup: \'2-4 Cameras (Altar Wide, Pastor Medium, Choir/Musician Angles)\',\n    keyRequirements: [\'Scripture & Lyric Overlays\', \'Multicast to YouTube/FB\', \'Archival Sunday Recordings\'],\n  },\n  {\n    id: \'corporate\',\n    title: \'CORPORATE EVENTS\',\n    description: \'Town halls, annual general meetings, and internal executive announcements streamed securely with end-to-end encryption and viewer access control.\',\n    image: \'https://images.unsplash.com/photo-1511578314322-379afb476865?q=80&w=1200&auto=format&fit=crop\',\n    cameraSetup: \'2-4 Cameras (Executive Desk, Podium, Audience Q&A)\',\n    keyRequirements: [\'Encrypted Custom RTMP\', \'Branded Lower Thirds\', \'PowerPoint / Keynote PIP\'],\n  },\n  {\n    id: \'brand-activations\',\n    title: \'BRAND ACTIVATIONS\',\n    description: \'Pop-up experiences, immersive experiential launches, and influencer showcases engineered for massive online engagement and viral social reach.\',\n    image: \'https://images.unsplash.com/photo-1505373877841-8d25f7d46678?q=80&w=1200&auto=format&fit=crop\',\n    cameraSetup: \'2-4 Mobile & PTZ Rigs\',\n    keyRequirements: [\'Vertical 9:16 Social Streams\', \'Live Interactive Polling\', \'Custom Sponsor Overlays\'],\n  },\n  {\n    id: \'weddings\',\n    title: \'WEDDINGS & PRIVATE EVENTS\',\n    description: \'Discreet, high-elegance multi-camera coverage for overseas family and loved ones who cannot attend in person.\',\n    image: \'https://images.unsplash.com/photo-1519741497674-611481863552?q=80&w=1200&auto=format&fit=crop\',\n    cameraSetup: \'2-3 Cinema Line Cameras (Unobtrusive Rigs)\',\n    keyRequirements: [\'Private Password Protected Feed\', \'Broadcast Audio Mic Kits\', \'Immediate Archive Copy\'],\n  },\n  {\n    id: \'sports\',\n    title: \'SPORTS & TOURNAMENTS\',\n    description: \'Fast-paced athletic coverage featuring instant replays, live scoreboard integration, multi-angle camera positions, and play-by-play audio feeds.\',\n    image: \'https://images.unsplash.com/photo-1508098682722-e99c43a406b2?q=80&w=1200&auto=format&fit=crop\',\n    cameraSetup: \'4-8 Cameras (High Center, Tight Action, Endzone, Slow-Mo ISO)\',\n    keyRequirements: [\'Hardware Slow-Motion Replay\', \'Real-time Scorebug Overlays\', \'Commentator Headsets\'],\n  },\n  {\n    id: \'product-launches\',\n    title: \'PRODUCT LAUNCHES\',\n    description: \'High-impact reveal broadcasts with cinematic lighting, crisp macro camera angles, and global press access across multiple digital destinations.\',\n    image: \'https://images.unsplash.com/photo-1505373877841-8d25f7d46678?q=80&w=1200&auto=format&fit=crop\',\n    cameraSetup: \'3-5 Cameras (Wide Stage, Product Close-up Macro, Audience Reaction)\',\n    keyRequirements: [\'Ultra-HD 4K Streaming\', \'Simultaneous Multi-Platform Push\', \'Sub-second Latency\'],\n  },\n  {\n    id: \'graduations\',\n    title: \'GRADUATIONS\',\n    description: \'Academic ceremonies captured with individual graduate name lower thirds, dual stage cameras, and live streams accessible worldwide.\',\n    image: \'https://images.unsplash.com/photo-1523240795612-9a054b0db644?q=80&w=1200&auto=format&fit=crop\',\n    cameraSetup: \'3-4 Cameras (Processional Wide, Stage Procession, Audience)\',\n    keyRequirements: [\'Automated Name Graphics Sync\', \'High Capacity Web CDN\', \'On-Demand Replay Archive\'],\n  },\n  {\n    id: \'charity\',\n    title: \'CHARITY & FUNDRAISING\',\n    description: \'Gala broadcasts featuring live donation total tickers, emotional testimonial videos, and real-time donor recognition displays.\',\n    image: \'https://images.unsplash.com/photo-1469571486292-0ba58a3f068b?q=80&w=1200&auto=format&fit=crop\',\n    cameraSetup: \'2-4 Cameras\',\n    keyRequirements: [\'Live Donation Meter Overlay\', \'Auction Mic Audio Integration\', \'Redundant Bonding\'],\n  },\n  {\n    id: \'virtual-hybrid\',\n    title: \'VIRTUAL & HYBRID EVENTS\',\n    description: \'Seamless bridging between on-stage presenters and remote international speakers with zero-latency video return feeds and interactive workshops.\',\n    image: \'https://images.unsplash.com/photo-1588196749597-9ff075ee6b5b?q=80&w=1200&auto=format&fit=crop\',\n    cameraSetup: \'3-5 Cameras + Remote Caller Ingest Rigs\',\n    keyRequirements: [\'Bi-directional Audio/Video Return\', \'LED Wall Background Mapping\', \'Dedicated Remote Stage Director\'],\n  },\n];\n\nexport const SERVICE_LEVELS: ServiceLevel[] = [\n  {\n    id: \'starter\',\n    name: \'STARTER\',\n    suitableFor: \'Intimate gatherings, press briefings, single-speaker keynotes, and small workshops.\',\n    cameraCount: \'1\342\200\2232 CAMERAS\',\n    features: [\n      \'1\342\200\2232 Cinema Line 4K Cameras\',\n      \'Basic Broadcast Audio Integration\',\n      \'Single Streaming Platform (YouTube / FB / RTMP)\',\n      \'High-Definition Local Recording\',\n      \'Standard Lower Third Graphics\',\n      \'1 Production Operator\',\n    ],\n    technicalHighlights: [\'1080p60 Stream Output\', \'Stereo XLR Audio Capture\', \'Core Lower Thirds Template\', \'Same-Day Digital Master Delivery\'],\n    recommendedFor: \'Small venues, localized audiences, single-room keynotes\',\n  },\n  {\n    id: \'standard\',\n    name: \'STANDARD\',\n    badge: \'MOST POPULAR\',\n    suitableFor: \'Medium-sized conferences, churches, corporate town halls, and panel discussions.\',\n    cameraCount: \'3\342\200\2234 CAMERAS\',\n    features: [\n      \'3\342\200\2234 Multi-Angle Cameras (Wide, Tight, PTZ)\',\n      \'Dedicated Vision Mixer & Live Switching\',\n      \'Custom Branded Broadcast Graphics & Lower Thirds\',\n      \'Simultaneous Streaming to Up to 2 Platforms\',\n      \'Multitrack Audio Mixing & Wireless Mics\',\n      \'Full Program Recording + ISO Backups\',\n      \'2\342\200\2233 Experienced Production Crew\',\n    ],\n    technicalHighlights: [\'4K Ingest / 1080p60 Output\', \'Dante Audio Console Integration\', \'Live Lower-Third Titles & Slides\', \'Bonded Cellular Network Option\'],\n    recommendedFor: \'Corporate AGMs, regional conferences, Sunday worship, product demos\',\n  },\n  {\n    id: \'premium\',\n    name: \'PREMIUM\',\n    suitableFor: \'Large conferences, multi-stage summits, concerts, festivals, and major brand events.\',\n    cameraCount: \'4\342\200\2236 CAMERAS\',\n    features: [\n      \'4\342\200\2236 Professional Cinema/Broadcast Cameras\',\n      \'Full Production Crew (Technical Director, Camera Ops, Audio Tech, Graphics Tech)\',\n      \'Advanced Motion Graphics, Stinger Transitions & Lower Thirds\',\n      \'Simultaneous Multi-Platform Streaming (3+ Destinations)\',\n      \'LED Screen & Venue Stage Monitor Integration\',\n      \'ProRes ISO Recording for Every Camera Feed\',\n      \'Bonded 5G / Satellite Internet Redundancy\',\n    ],\n    technicalHighlights: [\'ATEM 4 M/E Constellation Switcher\', \'EBU R128 Audio Mastering\', \'Live Instant Replay Capability\', \'Redundant Hardware Encoders\'],\n    recommendedFor: \'National summits, live concerts, international product reveals, hybrid galas\',\n  },\n  {\n    id: \'global-elite\',\n    name: \'GLOBAL ELITE\',\n    suitableFor: \'Major international productions, multi-day global congresses, and broadcast-network level events.\',\n    cameraCount: \'CUSTOM / 6+ CAMERAS\',\n    features: [\n      \'Custom Multi-Camera Rigging (6+ Cameras, Jibs, Wireless Gimbal, PTZ)\',\n      \'Multi-Day International Crew Deployment\',\n      \'Dedicated On-Site Production Manager & Technical Director\',\n      \'Full Broadcast Infrastructure & OB Flypack Racks\',\n      \'Custom RTMP & Encrypted Satellite / SRT Signal Delivery\',\n      \'Bi-Directional Remote Speaker Ingest & Green Room Rigs\',\n      \'Comprehensive On-Site Post-Production & Daily Highlight Edits\',\n    ],\n    technicalHighlights: [\'12G-SDI / 4K UHD Workflow\', \'Dual-Redundant Power & Network Bonding\', \'Multi-Language Audio Track Support\', \'Dedicated Satellite Uplink Integration\'],\n    recommendedFor: \'Global corporate summits, international music festivals, multi-city broadcasts\',\n  },\n];\n\nexport const FAQ_ITEMS: FAQItem[] = [\n  {\n    category: \'General\',\n    question: \'What types of events do you cover?\',\n    answer: \'D1 Streams provides live production for conferences, summits, concerts, music festivals, church services, corporate town halls, brand activations, product launches, sports tournaments, weddings, graduations, and hybrid virtual events worldwide.\',\n  },\n  {\n    category: \'Logistics\',\n    question: \'Do you operate outside the UK?\',\n    answer: \'Yes. While based in the United Kingdom, D1 Streams operates globally. Our modular flightcase production rigs (OB Flypacks) are engineered for rapid international air transport and global crew deployment.\',\n  },\n  {\n    category: \'Technical\',\n    question: \'How many cameras can you provide?\',\n    answer: \'Our standard configurations range from 1\342\200\2232 camera setups for intimate events up to 6\342\200\2238+ camera environments featuring wide stage angles, tight presenter tracking, audience reaction cameras, robotic PTZ systems, and wireless handheld cinema rigs.\',\n  },\n  {\n    category: \'Technical\',\n    question: \'Which platforms can you stream to?\',\n    answer: \'We stream simultaneously to any major platform including YouTube, Facebook Live, LinkedIn Live, X (Twitter), Twitch, Vimeo, Instagram, or custom private event portals.\',\n  },\n  {\n    category: \'Technical\',\n    question: \'Can you stream to custom RTMP destinations?\',\n    answer: \'Absoluty. We support secure RTMP, RTMPS, and SRT (Secure Reliable Transport) protocols to push streams directly into client intranets, custom enterprise portals, or proprietary paywall systems.\',\n  },\n  {\n    category: \'Logistics\',\n    question: \'Do you provide on-site production crews?\',\n    answer: \'Yes. Every D1 Streams deployment includes an experienced, professional technical crew \342\200\224 including Technical Directors, Vision Mixers, Camera Operators, Audio Engineers, and Floor Managers.\',\n  },\n  {\n    category: \'Technical\',\n    question: \'Can you integrate with existing venue audio?\',\n    answer: \'Yes. We routinely interface directly with venue front-of-house (FOH) sound consoles via XLR, Dante digital audio networks, or MADI, applying broadcast mastering compressors and EQ to deliver pristine audio to online viewers.\',\n  },\n  {\n    category: \'Technical\',\n    question: \'Can you integrate LED screens?\',\n    answer: \'Yes. We provide video mapping and return feeds for stage LED walls, confidence monitors, and venue IMAG (Image Magnification) displays while maintaining zero noticeable latency.\',\n  },\n  {\n    category: \'Technical\',\n    question: \'Can you provide recording?\',\n    answer: \'Yes. Every production includes local master program recording as standard. On Standard, Premium, and Global Elite tiers, we also capture individual ISO (Isolated) high-bitrate feeds for every camera in Apple ProRes or H.265.\',\n  },\n  {\n    category: \'Booking\',\n    question: \'How far in advance should we book?\',\n    answer: \'We recommend booking 3 to 6 weeks in advance for domestic UK events, and 6 to 12 weeks for complex international or multi-camera festival productions. However, we also accommodate short-notice emergency broadcast requests whenever crew schedule allows.\',\n  },\n  {\n    category: \'Booking\',\n    question: \'Can you create a custom production package?\',\n    answer: \'Yes. Every live event is unique. Our team works closely with your event producers to design a custom technical specification tailored to your venue acoustics, lighting, camera requirements, and budget.\',\n  },\n];\n"
    }
