    content: "import React from \'react\';\nimport { ShieldCheck, Lock } from \'lucide-react\';\n\nexport const Testimonials: React.FC = () => {\n  return (\n    <section className=\"py-16 bg-[#0D0D0E] border-b border-zinc-800/80\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"p-8 bg-zinc-950/80 border border-zinc-800/80 rounded-lg flex flex-col sm:flex-row items-center justify-between gap-6\">\n          <div className=\"flex items-center gap-4\">\n            <div className=\"p-3 bg-zinc-900 border border-zinc-800 rounded text-[#0066FF] shrink-0\">\n              <ShieldCheck className=\"w-6 h-6\" />\n            </div>\n            <div>\n              <p className=\"text-xs font-mono tracking-widest text-[#0066FF] uppercase font-bold\">\n                CLIENT CONFIDENTIALITY & INTEGRITY\n              </p>\n              <h3 className=\"text-base font-display font-bold uppercase text-white mt-0.5\">\n                VERIFIED CASE STUDIES & REVIEWS ARCHITECTURE\n              </h3>\n              <p className=\"text-xs font-mono text-zinc-400 mt-1 max-w-2xl\">\n                We respect strict NDA agreements for high-profile corporate, political, and ministry broadcasts. Verified client feedback is populated upon client authorization.\n              </p>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-2 px-3 py-1.5 bg-zinc-900 border border-zinc-800 text-[11px] font-mono text-zinc-400 shrink-0\">\n            <Lock className=\"w-3.5 h-3.5 text-zinc-500\" />\n            <span>NDA PROTECTED RECORDS</span>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};\n"
