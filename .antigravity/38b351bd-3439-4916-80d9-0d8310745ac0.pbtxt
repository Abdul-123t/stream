        target_content: "import React from \'react\';\nimport { ShieldCheck, Lock, Quote, Star } from \'lucide-react\';\n\nexport const Testimonials: React.FC = () => {\n  const testimonials = [\n    {\n      quote: \"D1 Streams elevated our annual global summit from a basic web stream into an international television-quality broadcast. Flawless multi-camera switches and zero latency.\",\n      author: \"DIRECTOR OF LIVE EVENTS\",\n      organization: \"INTERNATIONAL TECH & CORPORATE SUMMIT\",\n      sector: \"CORPORATE & CONFERENCES\",\n    },\n    {\n      quote: \"The audio clarity and camera switching during our 3-day multi-stage festival were remarkable. Their technical crew operated seamlessly alongside our stage management team.\",\n      author: \"HEAD PRODUCTION MANAGER\",\n      organization: \"EUROPEAN CULTURAL & MUSIC FESTIVAL\",\n      sector: \"CONCERTS & FESTIVALS\",\n    },\n    {\n      quote: \"When broadcasting to over 100,000 live remote participants across 4 continents, stability is non-negotiable. D1 Streams delivered rock-solid SRT redundancy throughout.\",\n      author: \"MEDIA OPERATIONS LEAD\",\n      organization: \"GLOBAL MINISTRIES & CONVENTION NETWORK\",\n      sector: \"GLOBAL CHURCHES & MINISTRIES\",\n    },\n  ];\n\n  return (\n    <section className=\"py-24 bg-[#0A0B0E] border-b border-zinc-800/80 relative overflow-hidden\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n        \n        {/* Section Header */}\n        <div className=\"mb-14\">\n          <p className=\"text-xs font-mono tracking-[0.2em] text-[#0066FF] uppercase font-bold mb-3\">\n            INDUSTRY TRUST & TESTIMONIALS\n          </p>\n          <h2 className=\"text-3xl sm:text-5xl lg:text-6xl font-black font-display uppercase tracking-tight text-white leading-[0.95]\">\n            REPUTATION BUILT ON<br />\n            <span className=\"text-[#0066FF]\">UNCOMPROMISING DELIVERY.</span>\n          </h2>\n        </div>\n\n        {/* 3 Client Testimonials Grid */}\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6 mb-12\">\n          {testimonials.map((t, idx) => (\n            <div\n              key={idx}\n              className=\"bg-zinc-950 border border-zinc-800/90 p-6 sm:p-8 rounded-lg flex flex-col justify-between space-y-6 relative group hover:border-zinc-700 transition-colors\"\n            >\n              <div className=\"space-y-4\">\n                <div className=\"flex items-center justify-between\">\n                  <div className=\"flex gap-1 text-[#0066FF]\">\n                    {[...Array(5)].map((_, i) => (\n                      <Star key={i} className=\"w-3.5 h-3.5 fill-[#0066FF]\" />\n                    ))}\n                  </div>\n                  <span className=\"text-[10px] font-mono text-zinc-500 uppercase px-2 py-0.5 bg-zinc-900 border border-zinc-800 rounded\">\n                    {t.sector}\n                  </span>\n                </div>\n\n                <Quote className=\"w-8 h-8 text-zinc-700 opacity-50\" />\n\n                <p className=\"text-sm font-sans text-zinc-300 leading-relaxed italic\">\n                  \"{t.quote}\"\n                </p>\n              </div>\n\n              <div className=\"pt-4 border-t border-zinc-800/80\">\n                <p className=\"text-xs font-mono font-bold text-white uppercase tracking-wider\">\n                  {t.author}\n                </p>\n                <p className=\"text-[11px] font-mono text-zinc-500 uppercase mt-0.5\">\n                  {t.organization}\n                </p>\n              </div>\n            </div>\n          ))}\n        </div>\n\n        {/* Confidentiality Notice */}\n        <div className=\"p-6 bg-zinc-950/80 border border-zinc-800/80 rounded-lg flex flex-col sm:flex-row items-center justify-between gap-6\">\n          <div className=\"flex items-center gap-4\">\n            <div className=\"p-3 bg-zinc-900 border border-zinc-800 rounded text-[#0066FF] shrink-0\">\n              <ShieldCheck className=\"w-6 h-6\" />\n            </div>\n            <div>\n              <p className=\"text-xs font-mono tracking-widest text-[#0066FF] uppercase font-bold\">\n                STRICT NDA & CONFIDENTIALITY PROTOCOLS\n              </p>\n              <h3 className=\"text-base font-display font-bold uppercase text-white mt-0.5\">\n                PROTECTING SENSITIVE CORPORATE & HIGH-PROFILE EVENTS\n              </h3>\n              <p className=\"text-xs font-mono text-zinc-400 mt-1 max-w-2xl\">\n                We maintain strict confidentiality protocols for private summits, corporate AGMs, government functions, and high-profile keynote broadcasts.\n              </p>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-2 px-3.5 py-2 bg-zinc-900 border border-zinc-800 text-[11px] font-mono text-zinc-300 shrink-0 rounded\">\n            <Lock className=\"w-3.5 h-3.5 text-[#0066FF]\" />\n            <span>ENCRYPTED BROADCAST PIPELINES</span>\n          </div>\n        </div>\n\n      </div>\n    </section>\n  );\n};"
        replacement_content: "import React from \'react\';\nimport { Building2, Radio, CheckCircle2, Shield } from \'lucide-react\';\n\nexport const Testimonials: React.FC = () => {\n  const recentWork = [\n    {\n      name: \'RCCG JESUS PALACE\',\n      badge: \'Recent Production\',\n      category: \'Churches & Worship Events\',\n    },\n    {\n      name: \'RCCG ZONE OF RESURRECTION\',\n      badge: \'Recent Production\',\n      category: \'Churches & Worship Events\',\n    },\n    {\n      name: \'RCCG PEACE ARENA\',\n      badge: \'Recent Production\',\n      category: \'Churches & Worship Events\',\n    },\n  ];\n\n  return (\n    <section className=\"py-24 bg-[#090A0D] border-b border-zinc-800/80 relative overflow-hidden\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n        \n        {/* Section Header */}\n        <div className=\"mb-14 space-y-3\">\n          <div className=\"inline-flex items-center gap-2 px-3 py-1 bg-zinc-900 border border-zinc-800 text-[11px] font-mono tracking-[0.2em] text-[#0066FF] uppercase font-bold\">\n            <Radio className=\"w-3.5 h-3.5 animate-pulse\" />\n            <span>PROVEN DELIVERIES</span>\n          </div>\n\n          <h2 className=\"text-3xl sm:text-5xl lg:text-6xl font-black font-display uppercase tracking-tight text-white leading-[0.95]\">\n            RECENT PRODUCTION WORK\n          </h2>\n\n          <p className=\"text-sm sm:text-base text-zinc-400 font-normal max-w-2xl leading-relaxed\">\n            Trusted to deliver professional live production across churches, events and large-scale gatherings.\n          </p>\n        </div>\n\n        {/* 3 Featured Recent Locations */}\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6 mb-12\">\n          {recentWork.map((location, idx) => (\n            <div\n              key={idx}\n              className=\"bg-zinc-950 border border-zinc-800/90 p-8 rounded-lg flex flex-col justify-between space-y-6 relative group hover:border-[#0066FF]/60 transition-all duration-300 shadow-xl\"\n            >\n              <div className=\"space-y-4\">\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"text-[10px] font-mono font-bold text-[#0066FF] uppercase tracking-widest px-2.5 py-1 bg-[#0066FF]/10 border border-[#0066FF]/30 rounded\">\n                    {location.badge}\n                  </span>\n                  <span className=\"text-xs font-mono text-zinc-600 font-bold\">\n                    0{idx + 1}\n                  </span>\n                </div>\n\n                <div className=\"p-3.5 bg-zinc-900 border border-zinc-800 rounded-md w-fit text-white group-hover:border-[#0066FF] transition-colors\">\n                  <Building2 className=\"w-6 h-6 text-[#0066FF]\" />\n                </div>\n\n                <div>\n                  <h3 className=\"text-xl font-black font-display uppercase tracking-tight text-white group-hover:text-[#0066FF] transition-colors\">\n                    {location.name}\n                  </h3>\n                  <p className=\"text-xs font-mono text-zinc-400 uppercase tracking-wider mt-1.5\">\n                    {location.category}\n                  </p>\n                </div>\n              </div>\n\n              <div className=\"pt-4 border-t border-zinc-800/80 flex items-center justify-between text-[11px] font-mono text-zinc-400\">\n                <span className=\"flex items-center gap-1.5 text-emerald-400\">\n                  <CheckCircle2 className=\"w-3.5 h-3.5\" />\n                  VERIFIED DEPLOYMENT\n                </span>\n                <span className=\"text-zinc-400 font-bold\">LIVE STREAM & BROADCAST</span>\n              </div>\n            </div>\n          ))}\n        </div>\n\n        {/* Optional Short Credibility Statement Banner */}\n        <div className=\"p-6 bg-zinc-950 border border-zinc-800 rounded-lg flex flex-col sm:flex-row items-center justify-between gap-6 text-center sm:text-left shadow-lg\">\n          <div className=\"flex items-center gap-4\">\n            <div className=\"p-3 bg-zinc-900 border border-zinc-800 rounded text-[#0066FF] shrink-0 hidden sm:block\">\n              <Shield className=\"w-5 h-5 text-[#0066FF]\" />\n            </div>\n            <div>\n              <p className=\"text-xs font-mono tracking-widest text-[#0066FF] uppercase font-bold\">\n                PRODUCTION INTEGRITY & EXPERIENCE\n              </p>\n              <p className=\"text-sm font-mono font-bold text-white uppercase mt-0.5\">\n                RECENTLY DELIVERING LIVE PRODUCTION FOR CHURCHES, EVENTS AND LARGE-SCALE GATHERINGS.\n              </p>\n            </div>\n          </div>\n\n          <span className=\"text-[11px] font-mono text-zinc-400 uppercase tracking-wider px-3.5 py-2 bg-zinc-900 border border-zinc-800 rounded shrink-0\">\n            CONFIDENTIAL & PROFESSIONAL STANDARDS\n          </span>\n        </div>\n\n      </div>\n    </section>\n  );\n};"
      }
      num_matches: 1
    }
  }
}
