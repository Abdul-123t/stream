    content: "import React from \'react\';\nimport { motion } from \'motion/react\';\nimport { Radio, Award, Film, Users } from \'lucide-react\';\n\nexport const Introduction: React.FC = () => {\n  return (\n    <section id=\"about\" className=\"py-24 lg:py-32 bg-[#0A0A0B] relative overflow-hidden border-b border-zinc-800/80\">\n      {/* Background subtleties */}\n      <div className=\"absolute top-0 right-0 w-96 h-96 bg-[#0066FF]/5 rounded-full blur-[140px] pointer-events-none\" />\n\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start\">\n          \n          {/* Left Column: Eyebrow & Big Statement */}\n          <div className=\"lg:col-span-5 space-y-6\">\n            <div className=\"inline-flex items-center gap-2 px-3 py-1 bg-zinc-900 border border-zinc-800 text-[11px] font-mono tracking-[0.2em] text-[#0066FF] uppercase font-bold\">\n              <Radio className=\"w-3.5 h-3.5 animate-pulse\" />\n              <span>D1 STREAMS</span>\n            </div>\n\n            <h2 className=\"text-3xl sm:text-5xl lg:text-6xl font-black font-display uppercase tracking-tight text-white leading-[0.95]\">\n              YOUR EVENT.<br />\n              <span className=\"text-[#0066FF]\">OUR BROADCAST.</span>\n            </h2>\n\n            {/* Fact stats badge */}\n            <div className=\"pt-4 grid grid-cols-2 gap-4 border-t border-zinc-800\">\n              <div>\n                <p className=\"text-xs font-mono text-zinc-500 uppercase tracking-wider\">ESTABLISHED</p>\n                <p className=\"text-2xl font-display font-bold text-white mt-0.5\">2021</p>\n                <p className=\"text-[11px] text-zinc-400 mt-0.5\">UK Based \302\267 Global Deployments</p>\n              </div>\n              <div>\n                <p className=\"text-xs font-mono text-zinc-500 uppercase tracking-wider\">STANDARD</p>\n                <p className=\"text-2xl font-display font-bold text-white mt-0.5\">4K / 1080p60</p>\n                <p className=\"text-[11px] text-zinc-400 mt-0.5\">Broadcast Level Delivery</p>\n              </div>\n            </div>\n          </div>\n\n          {/* Right Column: Editorial Body & The Big Idea Dominant Callout */}\n          <div className=\"lg:col-span-7 space-y-8 lg:pt-4\">\n            <p className=\"text-lg sm:text-xl text-zinc-300 font-normal leading-relaxed\">\n              D1 Streams transforms live events into polished, professional broadcasts designed for audiences wherever they are watching.\n            </p>\n\n            <p className=\"text-base text-zinc-400 leading-relaxed\">\n              From intimate gatherings to large-scale conferences, concerts and festivals, our production teams combine professional equipment, experienced crew and reliable live workflows to deliver exceptional coverage in real time.\n            </p>\n\n            {/* THE BIG IDEA \342\200\224 Visually Dominant Statement */}\n            <div className=\"p-8 sm:p-10 bg-zinc-950 border-l-4 border-[#0066FF] border-y border-r border-zinc-800 rounded-r-lg relative overflow-hidden shadow-2xl\">\n              <div className=\"absolute top-0 right-0 p-4 opacity-10 pointer-events-none\">\n                <Film className=\"w-32 h-32 text-white\" />\n              </div>\n              \n              <p className=\"text-[11px] font-mono tracking-[0.22em] text-[#0066FF] uppercase font-bold mb-3\">\n                THE D1 STREAMS PHILOSOPHY\n              </p>\n              \n              <h3 className=\"text-2xl sm:text-4xl lg:text-5xl font-black font-display uppercase tracking-tight text-white leading-[1.05]\">\n                WE DON\'T JUST STREAM THE EVENT. WE PRODUCE THE BROADCAST.\n              </h3>\n            </div>\n          </div>\n\n        </div>\n      </div>\n    </section>\n  );\n};\n"
    raw_content: "import React from \'react\';\nimport { motion } from \'motion/react\';\nimport { Radio, Award, Film, Users } from \'lucide-react\';\n\nexport const Introduction: React.FC = () => {\n  return (\n    <section id=\"about\" className=\"py-24 lg:py-32 bg-[#0A0A0B] relative overflow-hidden border-b border-zinc-800/80\">\n      {/* Background subtleties */}\n      <div className=\"absolute top-0 right-0 w-96 h-96 bg-[#0066FF]/5 rounded-full blur-[140px] pointer-events-none\" />\n\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start\">\n          \n          {/* Left Column: Eyebrow & Big Statement */}\n          <div className=\"lg:col-span-5 space-y-6\">\n            <div className=\"inline-flex items-center gap-2 px-3 py-1 bg-zinc-900 border border-zinc-800 text-[11px] font-mono tracking-[0.2em] text-[#0066FF] uppercase font-bold\">\n              <Radio className=\"w-3.5 h-3.5 animate-pulse\" />\n              <span>D1 STREAMS</span>\n            </div>\n\n            <h2 className=\"text-3xl sm:text-5xl lg:text-6xl font-black font-display uppercase tracking-tight text-white leading-[0.95]\">\n              YOUR EVENT.<br />\n              <span className=\"text-[#0066FF]\">OUR BROADCAST.</span>\n            </h2>\n\n            {/* Fact stats badge */}\n            <div className=\"pt-4 grid grid-cols-2 gap-4 border-t border-zinc-800\">\n              <div>\n                <p className=\"text-xs font-mono text-zinc-500 uppercase tracking-wider\">ESTABLISHED</p>\n                <p className=\"text-2xl font-display font-bold text-white mt-0.5\">2021</p>\n                <p className=\"text-[11px] text-zinc-400 mt-0.5\">UK Based \302\267 Global Deployments</p>\n              </div>\n              <div>\n                <p className=\"text-xs font-mono text-zinc-500 uppercase tracking-wider\">STANDARD</p>\n                <p className=\"text-2xl font-display font-bold text-white mt-0.5\">4K / 1080p60</p>\n                <p className=\"text-[11px] text-zinc-400 mt-0.5\">Broadcast Level Delivery</p>\n              </div>\n            </div>\n          </div>\n\n          {/* Right Column: Editorial Body & The Big Idea Dominant Callout */}\n          <div className=\"lg:col-span-7 space-y-8 lg:pt-4\">\n            <p className=\"text-lg sm:text-xl text-zinc-300 font-normal leading-relaxed\">\n              D1 Streams transforms live events into polished, professional broadcasts designed for audiences wherever they are watching.\n            </p>\n\n            <p className=\"text-base text-zinc-400 leading-relaxed\">\n              From intimate gatherings to large-scale conferences, concerts and festivals, our production teams combine professional equipment, experienced crew and reliable live workflows to deliver exceptional coverage in real time.\n            </p>\n\n            {/* THE BIG IDEA \342\200\224 Visually Dominant Statement */}\n            <div className=\"p-8 sm:p-10 bg-zinc-950 border-l-4 border-[#0066FF] border-y border-r border-zinc-800 rounded-r-lg relative overflow-hidden shadow-2xl\">\n              <div className=\"absolute top-0 right-0 p-4 opacity-10 pointer-events-none\">\n                <Film className=\"w-32 h-32 text-white\" />\n              </div>\n              \n              <p className=\"text-[11px] font-mono tracking-[0.22em] text-[#0066FF] uppercase font-bold mb-3\">\n                THE D1 STREAMS PHILOSOPHY\n              </p>\n              \n              <h3 className=\"text-2xl sm:text-4xl lg:text-5xl font-black font-display uppercase tracking-tight text-white leading-[1.05]\">\n                WE DON\'T JUST STREAM THE EVENT. WE PRODUCE THE BROADCAST.\n              </h3>\n            </div>\n          </div>\n\n        </div>\n      </div>\n    </section>\n  );\n};\n"
    num_lines: 72
    num_bytes: 3747
  }
}
