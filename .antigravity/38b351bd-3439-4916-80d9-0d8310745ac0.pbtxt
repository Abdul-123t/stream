         <span className=\"text-[#E50914]\">IS IN THE DETAILS.</span>\n          </h2>\n        </div>\n\n        {/* 4 Editorial Blocks */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n          {blocks.map((block, idx) => {\n            const Icon = block.icon;\n            return (\n              <div\n                key={block.title}\n                className=\"p-8 bg-zinc-950 border border-zinc-800 rounded-lg flex flex-col justify-between space-y-6 relative group hover:border-[#E50914] transition-colors duration-300\"\n              >\n                <div className=\"space-y-4\">\n                  <div className=\"flex items-center justify-between\">\n                    <div className=\"p-3 bg-zinc-900 border border-zinc-800 rounded text-[#E50914]\">\n                      <Icon className=\"w-6 h-6\" />\n                    </div>\n                    <span className=\"text-xs font-mono font-bold text-zinc-600\">\n                      0{idx + 1}\n                    </span>\n                  </div>\n\n                  <h3 className=\"text-2xl font-black font-display uppercase tracking-tight text-white group-hover:text-[#E50914] transition-colors\">\n                    {block.title}\n                  </h3>\n\n                  <p className=\"text-sm text-zinc-300 leading-relaxed font-normal\">\n                    {block.description}\n                  </p>\n                </div>\n\n                <div className=\"pt-4 border-t border-zinc-800/80 text-[11px] font-mono text-zinc-500 uppercase tracking-wider font-bold\">\n                  {block.spec}\n                </div>\n              </div>\n            );\n          })}\n        </div>\n\n      </div>\n    </section>\n  );\n};\n"
    }
