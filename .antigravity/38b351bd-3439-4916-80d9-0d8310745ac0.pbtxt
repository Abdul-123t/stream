" />\n              </button>\n            </div>\n\n            {/* Mobile Menu Toggle Button */}\n            <div className=\"flex md:hidden items-center gap-3\">\n              <button\n                onClick={onPlanProductionClick}\n                className=\"px-3 py-1.5 bg-[#E50914] text-white text-[10px] font-mono font-bold tracking-wider uppercase rounded\"\n              >\n                PLAN\n              </button>\n              <button\n                onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n                className=\"p-2 text-zinc-300 hover:text-white focus:outline-none\"\n                aria-label=\"Toggle menu\"\n              >\n                {mobileMenuOpen ? <X className=\"w-6 h-6\" /> : <Menu className=\"w-6 h-6\" />}\n              </button>\n            </div>\n          </div>\n        </div>\n      </header>\n\n      {/* Mobile Drawer */}\n      <AnimatePresence>\n        {mobileMenuOpen && (\n          <motion.div\n            initial={{ opacity: 0, y: -20 }}\n            animate={{ opacity: 1, y: 0 }}\n            exit={{ opacity: 0, y: -20 }}\n            transition={{ duration: 0.2 }}\n            className=\"fixed inset-0 z-40 bg-[#0A0A0B] pt-24 px-6 pb-8 flex flex-col justify-between border-b border-zinc-800 md:hidden\"\n          >\n            <div className=\"space-y-6\">\n              <div className=\"flex items-center gap-2 px-3 py-1.5 bg-zinc-900 border border-zinc-800 text-[11px] font-mono text-zinc-300 w-fit\">\n                <Radio className=\"w-3.5 h-3.5 text-[#E50914] animate-pulse\" />\n                <span>UK BASED \302\267 GLOBAL PRODUCTION</span>\n              </div>\n\n              <div className=\"flex flex-col space-y-4 pt-4\">\n                {navLinks.map((link) => (\n                  <a\n                    key={link.name}\n                    href={link.href}\n                    onClick={() => setMobileMenuOpen(false)}\n                    className=\"text-lg font-display font-bold uppercase tracking-wider text-zinc-200 hover:text-[#E50914] py-2 border-b border-zinc-800/50 flex items-center justify-between\"\n                  >\n                    <span>{link.name}</span>\n                    <ArrowRight className=\"w-4 h-4 text-zinc-500\" />\n                  </a>\n                ))}\n              </div>\n            </div>\n\n            <div className=\"space-y-4 pt-6 border-t border-zinc-800\">\n              <button\n                onClick={() => {\n                  setMobileMenuOpen(false);\n                  onPlanProductionClick();\n                }}\n                className=\"w-full py-3.5 bg-[#E50914] text-white text-xs font-mono font-bold uppercase tracking-[0.2em] flex items-center justify-center gap-2\"\n              >\n                <span>PLAN YOUR PRODUCTION</span>\n                <ArrowRight className=\"w-4 h-4\" />\n              </button>\n\n              <div className=\"grid grid-cols-1 gap-2 pt-2 text-xs font-mono text-zinc-400\">\n                <a href=\"tel:+447918916398\" className=\"flex items-center gap-2 hover:text-white\">\n                  <Phone className=\"w-3.5 h-3.5 text-[#E50914]\" />\n                  <span>+44 7918 916398</span>\n                </a>\n                <a href=\"mailto:dammyondnet@gmail.com\" className=\"flex items-center gap-2 hover:text-white\">\n                  <Mail className=\"w-3.5 h-3.5 text-[#E50914]\" />\n                  <span>dammyondnet@gmail.com</span>\n                </a>\n              </div>\n            </div>"
